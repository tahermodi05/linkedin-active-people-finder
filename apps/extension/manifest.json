{
  "manifest_version": 3,
  "name": "LinkedIn Active People Finder",
  "version": "1.0.0",

  "permissions": [
    "tabs",
    "scripting"
  ],

  "host_permissions": [
    "https://www.linkedin.com/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "extractors/*.js",
        "intelligence/*.js",
        "signals/*.js"
      ],
      "matches": [
        "https://www.linkedin.com/*"
      ]
    }
  ]
}